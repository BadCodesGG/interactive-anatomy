    "strip:sources": "node scripts/strip-sources.mjs",
    "posters": "node scripts/capture-posters.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@google/model-viewer": "^4.3.1",
    "@react-three/fiber": "~9.8.0",
    "camera-controls": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "meshoptimizer": "~1.2.0",
    "n8ao": "^2.0.1",
    "next": "^16.2.6",
    "postprocessing": "6.39.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
